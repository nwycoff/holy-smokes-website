{
  "name": "treehouse-pharmacy-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && node tests/customer-app.browser.mjs",
    "test:staff-browser": "npm run build && node tests/staff-enrollment.browser.mjs",
    "test:signup-browser": "npm run build && node tests/signup.browser.mjs",
    "test:tablet-browser": "npm run build && node tests/tablet-menu.browser.mjs",
    "test:site-browser": "npm run build && node tests/site-menu.browser.mjs",
    "css": "tailwindcss -c tailwind.config.cjs -i scripts/site-css/input.css -o assets/site/styles.css"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "jose": "6.2.12",
    "oauth4webapi": "3.8.8"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "tailwindcss": "3.4.17"
  }
}
